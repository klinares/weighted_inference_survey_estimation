extra_f   <- setdiff(factor_labels$factor, fnames)
if (length(missing_f) || length(extra_f))
stop("factor_labels.csv does not describe this model. ",
if (length(missing_f))
paste0("Missing: ", paste(missing_f, collapse = ", "), ". "),
if (length(extra_f))
paste0("Names a factor this model does not have: ",
paste(extra_f, collapse = ", "), ". "),
"Delete the file and re-render, or fix its factor column.",
call. = FALSE)
factor_labels <- factor_labels[match(fnames, factor_labels$factor), ]
lca_table(select(factor_labels, factor, Label, Description, High_end),
widths = c("5em", "10em", "19em", "7em"),
caption = "Factor names in use. Drafts: verify each against the
loading table above before quoting it.")
#| eval: !expr k_ready
# Two score types, for the same reason the class report shows two estimators.
# Regression scores are shrunk toward the grand mean by the factor's reliability,
# which pulls group means together; Bartlett scores remove that shrinkage at the
# cost of more error variance.
FS <- lavPredict(fit_w, method = "Bartlett")
FS_reg <- lavPredict(fit_w, method = "regression")
fnames <- colnames(FS)
# lavPredict returns one row per case lavaan actually used, and under WLSMV that
# is the item-complete cases. With complete_cases TRUE in the config the two
# frames coincide; with it FALSE they do not, and binding them column-wise would
# either fail or, worse, recycle a shorter score vector against the frame and
# attach every score to the wrong respondent.
if (nrow(FS) != nrow(dat))
stop("lavPredict returned ", nrow(FS), " scores for ", nrow(dat),
" respondents. WLSMV scores item-complete cases only: set ",
"complete_cases <- TRUE in survey_cfa_config.R.", call. = FALSE)
# Bartlett scores are unbounded and have no finite optimum for a small number of
# near-floor response patterns, which come back NA; regression scores are bounded
# by the prior and are always finite. Both arms must describe the same
# respondents, or the contrast between them confounds shrinkage with sample
# composition, which is the one thing this pair of designs exists to rule out.
# What the unscored cases have in common is not recorded here and is worth
# looking at when the count is more than a handful: the diagnostic in
# @sec-tails measures the finite extreme scores, which are a different and
# larger set, and finds them to be the floor and ceiling responders.
scorable <- complete.cases(FS)
if (!all(scorable)) {
message(sum(!scorable), " of ", nrow(dat), " respondents have no Bartlett ",
"score. Both score types are compared on the remaining ",
sum(scorable), ".")
}
if (mean(!scorable) > 0.02) {
stop("More than 2% of respondents are unscored under Bartlett. Investigate ",
"the failing response patterns before reporting either score type.",
call. = FALSE)
}
# Both frames lose the same respondents, and any demographic level those
# respondents were the last of goes with them, so the levels are dropped here
# too: svyby returns no row for an empty level while the theta function below
# still builds one, and the two would stop lining up.
scored     <- bind_cols(dat, as_tibble(FS))[scorable, ] |>
drop_empty_levels(cfg$aux, "scored frame")
scored_reg <- bind_cols(dat, as_tibble(FS_reg))[scorable, ] |>
drop_empty_levels(cfg$aux, "regression-scored frame")
design_s <- build_rep_design(scored, cfg)
rep_des_s <- design_s$rep_des
crit_s <- qt(0.975, degf(rep_des_s))
# A second design on the regression scores. Without it the design-based row and
# the Bartlett row read the same columns and come out identical, and the first
# gap would confound weighting with the choice of score.
design_reg <- build_rep_design(scored_reg, cfg)
rep_des_reg <- design_reg$rep_des
lam <- unclass(lavInspect(fit_w, "std")$lambda)
anchors <- map_chr(fnames, function(fn) rownames(lam)[which.max(abs(lam[, fn]))])
names(anchors) <- fnames
# Mean and SD are design-weighted; an unweighted mean here would be the one
# quantity in the report describing the sample instead of the population.
# IQR and Extreme sit beside SD because an unbounded estimator goes heavy-tailed
# near the response boundary, and SD alone would then describe a couple of dozen
# respondents rather than the spread of the factor. How far those respondents
# move the domain estimates is computed in @sec-tails rather than asserted here.
map(fnames, function(fn) {
m = svymean(reformulate(fn), rep_des_s, na.rm = TRUE)
v = svyvar(reformulate(fn), rep_des_s, na.rm = TRUE)
tibble(Factor = fn,
Mean = round(as.numeric(coef(m)), 3),
SD = round(sqrt(as.numeric(coef(v))), 3),
IQR = round(IQR(scored[[fn]]), 3),
Extreme = sum(abs(scored[[fn]]) > 5))
}) |>
list_rbind() |>
mutate(Label = factor_labels$Label,
Indicator = anchors[Factor],
Loading = round(map_dbl(Factor, function(fn) lam[anchors[[fn]], fn]), 2)) |>
select(Factor, Label, Mean, SD, IQR, Extreme, Indicator, Loading) |>
lca_table(align = "llrrrrlr", widths = fit_widths(8, first = 1.6),
font_size = 8,
caption = glue("Factor positions across the {sum(scorable)} scored \\
respondents, of {nrow(dat)} in the estimation frame. \\
Mean and SD are design-weighted. Extreme counts \\
respondents with a score beyond |5|."))
#| eval: !expr k_ready
marginals <- map(cfg$aux, function(v) {
m <- svymean(reformulate(v), rep_des_s, na.rm = TRUE)
raw <- scored |> filter(!is.na(.data[[v]])) |>
count(.data[[v]], name = "n") |> set_names(c("level", "n"))
tibble(variable = v, level = str_remove(names(coef(m)), paste0("^", v)),
weighted = as.numeric(coef(m)), se = as.numeric(SE(m))) |>
left_join(mutate(raw, level = as.character(level)), by = "level")
}) |>
list_rbind()
# Three estimators, matching the class report. Unweighted is a plain group mean
# with an iid standard error. Design-based adds the weights and takes its
# variance from the replicates. Bartlett additionally removes the shrinkage that
# regression scores impose on group differences.
dom_one <- function(frame, des, cr, est) {
crossing(variable = cfg$aux, factor = fnames) |>
pmap(function(variable, factor) {
if (is.null(des)) {
d = frame |>
filter(!is.na(.data[[variable]])) |>
group_by(level = as.character(.data[[variable]])) |>
summarise(p = mean(.data[[factor]]),
se = sd(.data[[factor]]) / sqrt(n()), .groups = "drop")
} else {
# coef() and SE() rather than columns 2 and 3. svyby's column layout
# varies with the statistic and the vartype, and a positional read is
# wrong silently rather than loudly: it returns a number of the right
# shape from the wrong column.
sb = svyby(reformulate(factor), reformulate(variable), des, svymean,
na.rm = TRUE)
d = tibble(level = as.character(sb[[variable]]),
p = as.numeric(coef(sb)), se = as.numeric(SE(sb)))
}
a = anchors[[factor]]
mutate(d, variable = variable, factor = factor,
segment = match(factor, fnames), estimator = est,
lo = p - cr * se, hi = p + cr * se,
# The translation is linear in p, so the interval travels through
# it unchanged in shape. Reporting the point alone invites a reader
# to treat a ladder position estimated from a dozen respondents as
# if it were read off the questionnaire. A negative loading flips
# the ends, so they are sorted rather than assumed.
.m = mean(as.numeric(dat[[a]]), na.rm = TRUE),
.s = sd(as.numeric(dat[[a]]), na.rm = TRUE),
expected = .m + p * lam[a, factor] * .s,
.e1 = .m + lo * lam[a, factor] * .s,
.e2 = .m + hi * lam[a, factor] * .s,
expected_lo = pmin(.e1, .e2), expected_hi = pmax(.e1, .e2)) |>
select(-.m, -.s, -.e1, -.e2)
}) |>
list_rbind()
}
est_levels <- c("Unweighted", "Design-based", "Bartlett")
domain <- bind_rows(
dom_one(scored_reg, NULL, qnorm(0.975), "Unweighted"),
dom_one(scored_reg, rep_des_reg, crit_s, "Design-based"),
dom_one(scored, rep_des_s, crit_s, "Bartlett")) |>
filter(!is.na(level)) |>
mutate(estimator = factor(estimator, levels = est_levels))
# The design-based domain estimates as one theta function, so the replicate
# covariance between levels exists and the separations can be tested rather than
# read off overlapping intervals. Design-based rather than Bartlett is
# deliberate: the regression scores are shrunk, so a pair resolved here
# separates despite that shrinkage.
dom_meta_cfa <- map(cfg$aux, function(v)
expand_grid(factor = fnames, level = levels(scored_reg[[v]])) |>
mutate(variable = v)) |>
list_rbind() |>
mutate(segment = match(factor, fnames), idx = row_number())
domain_theta_cfa <- function(w_rep) {
unlist(map(cfg$aux, function(v) {
M = outer(as.character(scored_reg[[v]]), levels(scored_reg[[v]]), "==") + 0
M[is.na(M)] = 0
denom = as.numeric(crossprod(M, w_rep))
unlist(map(fnames, function(f)
as.numeric(crossprod(M, w_rep * as.numeric(scored_reg[[f]]))) / denom),
use.names = FALSE)
}), use.names = FALSE)
}
est_cfa <- domain_theta_cfa(weights(design_reg$des, "sampling"))
V_cfa_dom <- replicate_variance(rep_des_reg, domain_theta_cfa, est_cfa)
# The same quantity svyby computed, by a different route. Agreement validates
# the ordering the contrasts index into.
chk <- dom_meta_cfa |>
mutate(p_theta = est_cfa) |>
inner_join(filter(domain, estimator == "Design-based") |>
select(variable, level, factor, p),
by = c("variable", "level", "factor"))
stopifnot(nrow(chk) == nrow(dom_meta_cfa),
max(abs(chk$p_theta - chk$p)) < 1e-6)
wald_cfa <- list(meta = dom_meta_cfa, est = est_cfa, V = V_cfa_dom,
df = degf(rep_des_reg))
wide_gap <- domain |>
select(variable, level, segment, estimator, p, se) |>
pivot_wider(names_from = estimator, values_from = c(p, se))
se_ratio <- wide_gap$`se_Design-based` / wide_gap$se_Unweighted
glue("Weighting moves the factor means by a median of ",
"{round(median(abs(wide_gap$`p_Design-based` -
wide_gap$p_Unweighted)), 3)}; ",
"unshrinking them moves a further ",
"{round(median(abs(wide_gap$p_Bartlett -
wide_gap$`p_Design-based`)), 3)}. ",
"Design-based intervals are a median of ",
"{round(median(se_ratio[is.finite(se_ratio)]), 2)} ",
"times the naive ones.")
#| echo: false
#| eval: !expr k_ready
#| results: asis
#| fig-height: 5.2
walk(cfg$aux, function(v) {
d <- filter(domain, variable == v)
lv <- unique(d$level)
cat("\n\n##", v, "\n\n")
d |>
transmute(Factor = factor_labels$Label[segment],
Estimator = as.character(estimator), Level = level,
cell = sprintf("%+.2f (%.3f)", p, se)) |>
pivot_wider(names_from = Level, values_from = cell) |>
arrange(Factor, match(Estimator, est_levels)) |>
lca_table(align = str_c("ll", strrep("r", length(lv))),
widths = fit_widths(2 + length(lv), first = 2.2), font_size = 7,
label = paste0("dom-", str_replace_all(v, "_", "-")),
caption = glue("Mean factor position by level of {v},
three ways.")) |>
cat(sep = "\n")
cat("\n\n")
d |>
filter(estimator == "Bartlett") |>
transmute(Factor = factor_labels$Label[segment], Level = level,
cell = sprintf("%.2f [%.2f, %.2f]", expected, expected_lo,
expected_hi)) |>
pivot_wider(names_from = Level, values_from = cell) |>
lca_table(align = str_c("l", strrep("r", length(lv))),
widths = fit_widths(1 + length(lv), first = 1.6), font_size = 7,
label = paste0("exp-", str_replace_all(v, "_", "-")),
caption = glue("The same positions as an expected answer on each ",
"factor's strongest indicator, with the interval ",
"carried through the linearisation.")) |>
cat(sep = "\n")
cat("\n\n")
p <- d |>
mutate(Factor = factor(factor_labels$Label[segment],
levels = factor_labels$Label),
Level = factor(level, levels = rev(lv))) |>
ggplot(aes(p, Level, color = estimator, shape = estimator)) +
geom_pointrange(aes(xmin = lo, xmax = hi), size = 0.3, linewidth = 0.35,
position = position_dodge(width = 0.55)) +
facet_wrap(~ Factor, ncol = min(3, length(fnames))) +
scale_color_viridis_d(begin = 0.15, end = 0.75) +
scale_shape_manual(values = c(Unweighted = 15, `Design-based` = 16,
Bartlett = 5)) +
labs(x = "Mean factor position", y = NULL, color = NULL, shape = NULL,
title = v) +
theme_lca()
print(p)
cat("\n\n{{< pagebreak >}}\n\n")
})
#| echo: false
#| eval: !expr k_ready
edge_counts <- dat |>
select(all_of(items)) |>
mutate(across(everything(),
function(x) as.integer(x == min(x, na.rm = TRUE) |
x == max(x, na.rm = TRUE)))) |>
rowSums(na.rm = TRUE)
edge_scored <- edge_counts[scorable]
map(fnames, function(f) {
b <- scored[[f]]
big <- abs(b) > 5
tibble(Factor = factor_labels$Label[match(f, fnames)],
SD = sd(b), IQR = IQR(b),
`SD vs normal` = sd(b) / (IQR(b) / 1.349),
`n over 5` = sum(big), `largest score` = max(abs(b)),
`items at an edge, extreme` = if (any(big)) mean(edge_scored[big]) else NA_real_,
`items at an edge, rest` = mean(edge_scored[!big]))
}) |>
list_rbind() |>
mutate(across(where(is.double), function(x) round(x, 2))) |>
lca_table(align = "lrrrrrrr", widths = fit_widths(8, first = 1.8), font_size = 7,
caption = glue("Shape of the Bartlett score distribution. SD equals
IQR / 1.349 for a normal, so a ratio well above one
says the spread is in the tails. The last two columns
count items answered at the floor or ceiling of their
observed range, out of {length(items)}."))
# svyby read through coef() and SE(), for the reason given in the domains chunk.
svyby_tbl <- function(f, v, des) {
sb <- svyby(reformulate(f), reformulate(v), des, svymean, na.rm = TRUE)
tibble(level = as.character(sb[[v]]), est = as.numeric(coef(sb)),
se = as.numeric(SE(sb)))
}
# Trimming can leave a stratum with one PSU, which build_rep_design() treats as
# a hard stop. That is the check working: the comparison is then unavailable
# rather than computed on a design that cannot estimate its own variance.
tail_sens <- map(fnames, function(f) {
keep <- abs(scored[[f]]) <= 5
des_trim <- try(build_rep_design(scored[keep, ], cfg)$rep_des, silent = TRUE)
if (inherits(des_trim, "try-error")) return(NULL)
map(cfg$aux, function(v) {
svyby_tbl(f, v, rep_des_s) |>
rename(est_full = est, se_full = se) |>
left_join(rename(svyby_tbl(f, v, des_trim), est_trim = est, se_trim = se),
by = "level") |>
mutate(Factor = f, Variable = v, shift_in_se = abs(est_full - est_trim) / se_full,
se_ratio = se_full / se_trim, dropped = sum(!keep))
}) |>
list_rbind()
}) |>
list_rbind()
if (is.null(tail_sens) || nrow(tail_sens) == 0) {
cat("Trimming the extreme scores leaves a stratum with a single PSU, so the",
"comparison is unavailable on this file.\n")
} else {
tail_sens |>
slice_max(shift_in_se, n = 6) |>
transmute(Factor = factor_labels$Label[match(Factor, fnames)],
Variable, Level = level,
`Bartlett` = sprintf("%+.3f (%.3f)", est_full, se_full),
`Extremes removed` = sprintf("%+.3f (%.3f)", est_trim, se_trim),
`Shift in SE` = sprintf("%.2f", shift_in_se),
`SE ratio` = sprintf("%.2f", se_ratio)) |>
lca_table(align = "lllrrrr", widths = fit_widths(7, first = 1.8), font_size = 7,
caption = glue("The six cells the extreme scores move most, of ",
"{nrow(tail_sens)}, after removing the ",
"{paste(unique(tail_sens$dropped), collapse = ' and ')} ",
"respondents beyond |5| on each factor. A shift ",
"approaching or above one standard error means that ",
"cell's Bartlett estimate is partly the estimator ",
"reaching the response boundary rather than the ",
"group differing."))
}
#| echo: false
#| eval: !expr k_ready
v1 <- cfg$aux[1]
cat("=========== USER PROMPT (", v1, ") ===========\n")
cat(wrap_text(prompt_domain_read(
domain, marginals, v1,
values_header =
"Mean factor position of each level, with 95 percent intervals:",
labels = factor_labels$Label, context = cfg$survey_context,
wald = wald_cfa)), "\n")
#| eval: !expr k_ready
domain_reads <- map(cfg$aux, function(v) {
obj <- parse_json_block(
llm_chat(cfg, persona_cfa, role = "editor")$chat(
prompt_domain_read(
domain, marginals, v, labels = factor_labels$Label,
context = cfg$survey_context,
values_header =
"Mean factor position of each level, with 95 percent intervals:",
wald = wald_cfa),
echo = FALSE))
tibble(variable = v,
Finding = pluck(obj, "finding", .default = NA_character_),
Caution = pluck(obj, "caution", .default = NA_character_))
}) |>
list_rbind()
lca_table(domain_reads, widths = c("7em", "22em", "16em"),
caption = "Drafted reading of each demographic. Verify against the
tables above.")
#| eval: !expr k_ready
out_sav <- scored
haven::write_sav(out_sav, file.path(cfg$cfa_dir, "survey_with_factor.sav"))
write_csv(param_tbl, file.path(cfg$cfa_dir, "cfa_measurement_model.csv"))
write_csv(domain, file.path(cfg$cfa_dir, "factor_domains.csv"))
write_csv(marginals, file.path(cfg$cfa_dir, "demographic_marginals_cfa.csv"))
saveRDS(list(fit = fit_w, param_tbl = param_tbl, eig_tbl = eig_tbl,
efa_tbl = efa_tbl, domain = domain, marginals = marginals,
items = items, n_factors = cfg$n_factors,
factor_labels = factor_labels, anchors = anchors),
file.path(cfg$cfa_dir, "cfa_fit.rds"))
glue("Wrote survey_with_factor.sav, three CSVs, and cfa_fit.rds to",
cfg$cfa_dir, "\n")
# Bartlett tail diagnostic for the factor report.
#
# Paste after the `score` chunk, where scored, scored_reg, rep_des_s, fnames,
# dat and cfg all exist. It computes the check the score chunk's comment claims
# but never runs: how far the Bartlett domain means move when the extreme scores
# are removed, in units of their own standard error.
#
# NOT RUN. Written while the R runtime was unavailable, so it has not been
# executed even once. Treat the first run as a test of this code, not of the
# data: read the errors before reading the numbers.
# ---- 1. Is the tail doing the work? -----------------------------------------
# For a normal distribution SD = IQR / 1.349. A ratio well above 1 means the
# spread is coming from the tails rather than the body, which is what makes a
# cell mean's variance depend on which cell the extreme respondents fell into.
tail_shape <- map(fnames, function(f) {
b <- scored[[f]]
tibble(Factor = f,
SD = sd(b),
IQR = IQR(b),
`SD vs normal` = sd(b) / (IQR(b) / 1.349),
`n over 5` = sum(abs(b) > 5),
`largest score` = max(abs(b)))
}) |>
list_rbind()
print(as.data.frame(tail_shape |> mutate(across(where(is.double), \(x) round(x, 2)))))
# ---- 2. Where do the extreme respondents sit? -------------------------------
# If they concentrate in one or two demographic levels, those are the cells
# whose intervals widened and whose point estimates moved.
extreme_by_level <- map(fnames, function(f) {
map(cfg$aux, function(v) {
scored |>
mutate(.extreme = abs(.data[[f]]) > 5) |>
count(level = as.character(.data[[v]]), .extreme) |>
filter(.extreme) |>
transmute(Factor = f, Variable = v, Level = level, n_extreme = n)
}) |>
list_rbind()
}) |>
list_rbind()
print(as.data.frame(extreme_by_level))
# ---- 3. Are the extremes floor and ceiling patterns? ------------------------
# The score chunk asserts they are idiosyncratic rather than the tails of the
# factor. For ordinal indicators the ML score has no bounded optimum for a
# respondent who answered at one end of every item, so the opposite is the
# thing to expect. This counts how many items each respondent answered at the
# floor or the ceiling of its own observed range.
edge_counts <- dat |>
select(all_of(cfg$items)) |>
mutate(across(everything(), function(x) as.integer(x == min(x, na.rm = TRUE) |
x == max(x, na.rm = TRUE)))) |>
rowSums(na.rm = TRUE)
edge_vs_score <- map(fnames, function(f) {
tibble(Factor = f,
extreme = abs(scored[[f]]) > 5,
edges = edge_counts[complete.cases(lavPredict(fit_w, method = "Bartlett"))]) |>
group_by(Factor, extreme) |>
summarise(n = n(), mean_items_at_an_edge = mean(edges), .groups = "drop")
}) |>
list_rbind()
print(as.data.frame(edge_vs_score |> mutate(across(where(is.double), \(x) round(x, 2)))))
# ---- 4. The sensitivity itself ----------------------------------------------
# Domain means with and without the extreme scores, on the same replicate
# machinery. shift_in_se is the number the comment asserts is below 1.
#
# Trimming can in principle empty a PSU or leave a stratum with one, which
# build_rep_design() treats as a hard stop. If it halts here, that is the check
# working: report the trimmed comparison as unavailable rather than collapsing
# strata to get a number.
# svyby's columns are read through coef() and SE() rather than by position.
# Position is what broke the first version of this script: a column named `full`
# inside tibble() shadowed the data frame of the same name, because tibble
# evaluates its arguments in order in its own data mask. With four age levels
# that silently returned the third group's mean as the standard error; with two
# sex levels it went out of bounds and errored. The error was the lucky case.
svyby_tbl <- function(f, v, des) {
sb <- svyby(reformulate(f), reformulate(v), des, svymean, na.rm = TRUE)
tibble(Level = as.character(sb[[v]]),
est = as.numeric(coef(sb)),
se = as.numeric(SE(sb)))
}
bartlett_sensitivity <- map(fnames, function(f) {
keep <- abs(scored[[f]]) <= 5
des_trim <- build_rep_design(scored[keep, ], cfg)$rep_des
map(cfg$aux, function(v) {
kept <- svyby_tbl(f, v, rep_des_s) |> rename(est_full = est, se_full = se)
trim <- svyby_tbl(f, v, des_trim) |> rename(est_trim = est, se_trim = se)
kept |>
left_join(trim, by = "Level") |>
mutate(Factor = f, Variable = v,
shift = est_full - est_trim,
shift_in_se = abs(shift) / se_full,
se_ratio = se_full / se_trim,
dropped = sum(!keep)) |>
select(Factor, Variable, Level, est_full, se_full, est_trim, se_trim,
shift, shift_in_se, se_ratio, dropped)
}) |>
list_rbind()
}) |>
list_rbind()
print(as.data.frame(bartlett_sensitivity |>
mutate(across(where(is.double), \(x) round(x, 3)))))
cat("\nLargest move from trimming, in units of its own standard error: ",
sprintf("%.2f", max(bartlett_sensitivity$shift_in_se, na.rm = TRUE)),
"\nThe score chunk's comment asserts this is below 1. If it is not, the",
"\ncomment is wrong for this file and the Bartlett column is being driven",
"\nby a handful of respondents rather than by removing shrinkage.\n")
