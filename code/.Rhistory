arrange(segment)
if(nrow(hits) == 0) return("  None: every pair of levels overlaps on every segment.")
paste(map_chr(seq_len(nrow(hits)), function(i) {
nm = if(is.null(labels)) paste0("Segment ", hits$segment[i]) else labels[hits$segment[i]]
str_glue("  {nm}: {hits$a[i]} differs from {hits$b[i]}")
}), collapse = "\n")
}
prompt_domain_read <- function(
dom, marg, variable, labels = NULL, context = NULL, min_n = 30,
values_header = "Share of each level falling in each segment:",
est = "Design-based") {
ctx = if(!is.null(context) && nzchar(context)) str_glue("SURVEY CONTEXT\n{context}\n\n") else ""
str_glue(
"{ctx}",
"COMPOSITION OF THE POPULATION AND OF EACH GROUP\n",
"{format_domain_block(dom, marg, variable, labels, min_n, values_header, est)}\n\n",
"DIFFERENCES THAT CLEAR THE CONFIDENCE INTERVAL\n",
"{domain_separations(dom, variable, labels, est)}\n\n",
"WHAT THE SURVEY DESIGN CHANGES\n",
"{format_estimator_shift(dom, variable, labels)}\n\n",
"TASK\n",
"Write two or three sentences telling an analyst what this variable shows ",
"and where to look. Name only the differences listed above as clearing the ",
"interval. In the caution field, say what accounting for the survey design ",
"changed: whether it moved any estimate enough to matter and whether it made ",
"the intervals wider or narrower.\n\n",
"{rules_domain}\n",
'JSON (one object): {{"finding": "...", "caution": "..."}}')
}
#| echo: false
#| eval: !expr k_ready
v1 <- cfg$aux[1]
cat("=========== USER PROMPT (", v1, ") ===========\n")
cat(wrap_text(prompt_domain_read(
domain, marginals, v1,
values_header =
"Mean factor position of each level, with 95 percent intervals:",
labels = factor_labels$Label, context = cfg$survey_context)), "\n")
#| include: false
pacman::p_load(lavaan, matrixStats, clue, survey, furrr, kableExtra,
here, glue, sjlabelled, haven, knitr, tidyverse)
source("source_code.R")
source("survey_cfa_config.R")
init_parallel(cfg)
# The search sections below run either way; everything from the chosen model on
# waits until cfg$n_factors is set.
k_ready <- !is.null(cfg$n_factors)
dat <- cfg$data
w_vec <- dat[[cfg$weight]]
n_obs <- nrow(dat)
items <- cfg$items
n_eff <- sum(w_vec)^2 / sum(w_vec^2)
design <- build_rep_design(dat, cfg)
des <- design$des
rep_des <- design$rep_des
nu <- degf(rep_des)
crit <- qt(0.975, nu)
glue("{length(items)} items, {n_obs} cases. ",
"Design: {ncol(rep_des$repweights)} replicates, {nu} degrees of freedom. ",
"Weights: CV = {round(sd(w_vec) / mean(w_vec), 3)}, ",
"unequal weighting effect = {round(1 + (sd(w_vec) / mean(w_vec))^2, 2)}.")
R <- wcor(w_vec, items, dat)
eig_hat <- eigen(R, only.values = TRUE)$values
set.seed(cfg$seed)
pa <- map(1:200, function(i)
eigen(cor(matrix(rnorm(round(n_eff) * length(items)),
round(n_eff), length(items))), only.values = TRUE)$values) |>
do.call(what = rbind)
eig_tbl <- tibble(factor = seq_along(items), eigenvalue = eig_hat,
se = sqrt(diag(replicate_variance(
rep_des,
function(w) eigen(wcor(w, items, dat), only.values = TRUE)$values,
eig_hat)))) |>
mutate(lo = eigenvalue - crit * se, hi = eigenvalue + crit * se,
random_95 = apply(pa, 2, quantile, 0.95),
retain = lo > random_95)
eig_tbl |>
filter(factor <= max(cfg$k_range)) |>
mutate(across(where(is.numeric), function(x) round(x, 3))) |>
lca_table(align = "r",
caption = "Design-weighted eigenvalues against a random-data threshold at the effective sample size.")
efa_fits <- future_map(cfg$k_range, function(k) fit_efa(k, w_vec, items, dat),
.options = furrr_options(seed = NULL,
packages = c("lavaan", "dplyr")))
Wm <- weights(rep_des, type = "analysis")
efa_tbl <- map2(cfg$k_range, efa_fits, function(k, f) {
fit <- as_fit(f)
if (inherits(fit, "try-error")) return(tibble(k = k, converged = FALSE))
fm <- fitMeasures(fit)
pick <- function(nm) if (nm %in% names(fm)) as.numeric(fm[nm]) else NA_real_
ref <- efa_pattern(f)
reps <- future_map(seq_len(ncol(Wm)),
function(r) efa_pattern(fit_efa(k, Wm[, r], items, dat)),
.options = furrr_options(seed = NULL,
packages = c("lavaan", "dplyr")))
ok <- !map_lgl(reps, is.null)
tibble(k = k, rep_ok = sum(ok),
admissible = lavInspect(fit, "post.check"),
min_resid = min(diag(lavInspect(fit, "theta"))),
cfi = pick("cfi.scaled"), rmsea = pick("rmsea.scaled"),
srmr = pick("srmr"),
stability = mean(map_lgl(reps, function(p) !is.null(p) &&
identical(p, ref))))
}) |>
list_rbind()
efa_tbl |>
mutate(across(where(is.numeric), function(x) round(x, 3))) |>
lca_table(align = "r",
caption = "Factor solutions compared. Read admissible first, then stability.")
# A generalized design effect for this battery, taken from the item means. It is
# available before the model is fitted, which the loading design effects are not,
# and it costs one svymean call.
gdeff <- median(as.numeric(deff(svymean(reformulate(items), rep_des,
deff = "replace", na.rm = TRUE))),
na.rm = TRUE)
lrt_tbl <- map(head(cfg$k_range, -1), function(k) {
a <- as_fit(efa_fits[[which(cfg$k_range == k)]])
b <- as_fit(efa_fits[[which(cfg$k_range == k + 1)]])
if (inherits(a, "try-error") || inherits(b, "try-error"))
return(tibble(comparison = paste(k, "vs", k + 1)))
t <- try(lavTestLRT(a, b), silent = TRUE)
if (inherits(t, "try-error")) return(tibble(comparison = paste(k, "vs", k + 1)))
chi <- as.numeric(t[2, "Chisq diff"]); df <- as.numeric(t[2, "Df diff"])
tibble(comparison = paste(k, "vs", k + 1), chisq = chi, df = df,
p_naive = pchisq(chi, df, lower.tail = FALSE),
p_design = pchisq(chi / gdeff, df, lower.tail = FALSE))
}) |>
list_rbind()
lrt_tbl |>
mutate(across(c(chisq), function(x) round(x, 1)),
across(starts_with("p_"), function(x) sprintf("%.4f", x))) |>
lca_table(align = "lrrrr",
col.names = c("Comparison", "Chi-square", "df", "p naive", "p adjusted"),
widths = fit_widths(5, first = 1.6), font_size = 8,
caption = paste0("Nested comparison of successive factor solutions, naive and design-adjusted (deff ",
round(gdeff, 2),
"), a first-order approximation to a Rao-Scott correction. Read it as a guide, not an exact test."))
#| echo: false
#| fig-height: 2.8
#| fig-cap: "Eigenvalues against the random-data threshold, and structure stability across leave-one-cluster-out refits. The dashed lines are the reference each panel is read against."
bind_rows(
eig_tbl |> filter(factor <= max(cfg$k_range)) |>
transmute(k = factor, panel = "Eigenvalue", value = eigenvalue,
lo, hi, ref = random_95),
efa_tbl |> transmute(k, panel = "Stability", value = stability,
lo = NA_real_, hi = NA_real_, ref = 0.9)) |>
ggplot(aes(k, value)) +
geom_line(colour = viridisLite::viridis(1, begin = 0.4)) +
geom_pointrange(aes(ymin = lo, ymax = hi), size = 0.3, na.rm = TRUE) +
geom_line(aes(y = ref), linetype = "dashed", colour = "grey45") +
facet_wrap(~ panel, scales = "free_y") +
scale_x_continuous(breaks = cfg$k_range) +
labs(x = "Number of factors", y = NULL) +
theme_lca()
#| echo: false
#| results: asis
walk(cfg$k_range, function(k) {
L <- efa_loadings(efa_fits[[which(cfg$k_range == k)]])
if (is.null(L)) return(invisible(NULL))
cat("\n\n###", k, "factors\n\n")
L |>
mutate(show = if_else(abs(loading) >= 0.40, sprintf("%.2f", loading), ".")) |>
select(item, factor, show) |>
pivot_wider(names_from = factor, values_from = show) |>
lca_table(label = paste0("load-", k),
caption = paste0("Standardised loadings at ", k,
" factors, blanked below 0.40.")) |>
cat(sep = "\n")
cat("\n\n")
flagged <- L |> filter(!is.na(flag)) |> distinct(item, h2, flag)
if (nrow(flagged))
cat(paste0("Flagged: ",
paste(sprintf("%s (%s, h2 = %.2f)", flagged$item, flagged$flag,
flagged$h2), collapse = "; "), "\n\n"))
else cat("No item flagged.\n\n")
})
#| results: asis
if (!k_ready)
cat("**`cfg$n_factors` is `NULL`.** Read the evidence above, set the factor",
"count and, if more than one, the item assignment in `cfg$cfa_factors`,",
"then re-render. Everything below waits on that.\n")
#| eval: !expr k_ready
if (!is.null(cfg$cfa_factors)) check_factors(cfg$cfa_factors, items)
stopifnot(is.null(cfg$cfa_factors) ||
length(cfg$cfa_factors) == cfg$n_factors)
cat(cfa_syntax(items, cfg$cfa_factors, cfg$cfa_free), "\n")
#| eval: !expr k_ready
fit_w <- fit_cfa(w_vec, items, dat, cfg$cfa_factors, cfg$cfa_free)
fm <- fitMeasures(fit_w)
glue("Converged: {lavInspect(fit_w, 'converged')}. ",
"{fm['npar']} free parameters on {n_obs} cases. ",
"Robust CFI {round(fm['cfi.scaled'], 3)}, TLI {round(fm['tli.scaled'], 3)}, ",
"RMSEA {round(fm['rmsea.scaled'], 3)}, SRMR {round(fm['srmr'], 3)}.")
#| eval: !expr k_ready
par_names <- names(coef(fit_w))
theta_cfa <- function(w_rep) {
f <- try(fit_cfa(w_rep, items, dat, cfg$cfa_factors, cfg$cfa_free), silent = TRUE)
if (inherits(f, "try-error") || !lavInspect(f, "converged"))
return(rep(NA_real_, length(par_names)))
coef(f)[par_names]
}
Theta <- do.call(rbind, future_map(seq_len(ncol(Wm)),
function(r) theta_cfa(Wm[, r]),
.options = furrr_options(seed = NULL)))
ok <- complete.cases(Theta)
d_dev <- sweep(Theta[ok, , drop = FALSE], 2, coef(fit_w)[par_names], "-")
V_cfa <- rep_des$scale * crossprod(d_dev * sqrt(rep_des$rscales[ok]))
param_tbl <- tibble(parameter = par_names,
estimate = as.numeric(coef(fit_w)[par_names]),
se_design = sqrt(diag(V_cfa)),
se_model = as.numeric(sqrt(diag(vcov(fit_w)))[par_names])) |>
mutate(kind = if_else(str_detect(parameter, "=~"), "loading", "threshold"),
deff = (se_design / se_model)^2,
lo = estimate - crit * se_design, hi = estimate + crit * se_design)
glue("Replicates converged: {sum(ok)} of {nrow(Theta)}.")
param_tbl |>
filter(kind == "loading") |>
transmute(Parameter = str_remove(parameter, "^.*=~"),
Estimate = sprintf("%.3f", estimate),
`95% CI` = sprintf("[%.3f, %.3f]", lo, hi),
`SE design` = sprintf("%.4f", se_design),
`SE lavaan` = sprintf("%.4f", se_model),
Deff = sprintf("%.2f", deff)) |>
lca_table(align = "lrrrrr", widths = fit_widths(6, first = 1.8), font_size = 7,
caption = "Loadings with design-based intervals, and the design effect on each.")
#| eval: !expr k_ready
#| echo: false
#| fig-height: 4.2
#| fig-cap: "Loadings with 95 percent JKn intervals. The anchor item is fixed at 1 and has none."
# The marker item has no free parameter, so it is absent from param_tbl. Recover
# it from the loading matrix: it is the item with a non-zero entry and no row of
# its own in the estimated table.
free_items <- str_remove(filter(param_tbl, kind == "loading")$parameter, "^.*=~")
anchor_tbl <- as_tibble(unclass(lavInspect(fit_w, "est")$lambda),
rownames = "item") |>
pivot_longer(-item, names_to = "factor", values_to = "estimate") |>
filter(estimate != 0, !item %in% free_items) |>
mutate(lo = NA_real_, hi = NA_real_)
param_tbl |>
filter(kind == "loading") |>
mutate(item = str_remove(parameter, "^.*=~"),
factor = str_remove(parameter, "=~.*$")) |>
select(item, factor, estimate, lo, hi) |>
bind_rows(anchor_tbl) |>
mutate(item = fct_reorder(item, estimate), anchor = is.na(lo)) |>
ggplot(aes(estimate, item)) +
geom_col(aes(fill = anchor), width = 0.6) +
geom_linerange(aes(xmin = lo, xmax = hi), linewidth = 0.45, na.rm = TRUE) +
facet_wrap(~ factor, scales = "free_y") +
scale_fill_manual(values = c(`FALSE` = viridisLite::viridis(1, begin = 0.55),
`TRUE` = "grey75"),
labels = c(`FALSE` = "estimated", `TRUE` = "anchor, fixed at 1")) +
labs(x = "Loading (marker scale)", y = NULL, fill = NULL) +
theme_lca()
#| eval: !expr k_ready
#| echo: false
#| fig-height: 5.6
#| fig-cap: "The fitted measurement model. Each edge carries the standardised loading, from 0 to 1."
lam_std <- unclass(lavInspect(fit_w, "std")$lambda)
fac <- colnames(lam_std)
# Items are stacked by the factor they load on, and each node sits beside its own
# block. With more than one factor a shared centre would send every edge across
# the whole picture and they would all overlap.
assign_tbl <- tibble(item = rownames(lam_std),
factor = fac[apply(abs(lam_std), 1, which.max)],
top = apply(abs(lam_std), 1, max)) |>
arrange(match(factor, fac), top) |>
mutate(y = row_number())
nodes <- assign_tbl |>
group_by(factor) |>
summarise(ny = mean(y), .groups = "drop") |>
arrange(match(factor, fac))
edges <- as_tibble(lam_std, rownames = "item") |>
pivot_longer(-item, names_to = "factor", values_to = "loading") |>
filter(abs(loading) > 0.05) |>
left_join(select(assign_tbl, item, y), by = "item") |>
left_join(nodes, by = "factor")
J <- nrow(assign_tbl)
ggplot(edges) +
geom_curve(aes(x = 0.20, y = ny, xend = 0.58, yend = y,
linewidth = abs(loading), alpha = abs(loading), colour = factor),
curvature = 0.10) +
geom_label(aes(x = 0.42, y = (y + ny) / 2, label = sprintf("%.2f", loading),
colour = factor),
size = 2.2, label.size = 0, fill = "white",
label.padding = unit(1.5, "pt")) +
geom_text(aes(x = 0.60, y = y, label = item), data = assign_tbl,
hjust = 0, size = 2.9, inherit.aes = FALSE) +
geom_label(data = nodes, aes(x = 0.20, y = ny, label = str_wrap(factor, 12)),
size = 2.8, fill = "grey96", label.r = unit(8, "pt"),
label.padding = unit(6, "pt"), inherit.aes = FALSE) +
scale_linewidth(range = c(0.2, 2.0)) +
scale_alpha(range = c(0.3, 0.9)) +
scale_colour_viridis_d(begin = 0.15, end = 0.65) +
scale_x_continuous(limits = c(0.10, 1.02)) +
scale_y_continuous(limits = c(0.3, J + 0.7)) +
labs(x = NULL, y = NULL) +
theme_void() +
theme(legend.position = "none")
#| echo: false
#| eval: !expr k_ready
param_tbl |>
group_by(kind) |>
summarise(n = n(), median_deff = round(median(deff, na.rm = TRUE), 2),
.groups = "drop") |>
lca_table(align = "lrr",
caption = "Design effects by parameter type.")
#| echo: false
#| eval: !expr k_ready
modindices(fit_w, sort = TRUE, minimum.value = 10) |>
filter(op == "~~") |>
slice_head(n = 10) |>
transmute(`Item A` = lhs, `Item B` = rhs,
MI = sprintf("%.1f", mi), EPC = sprintf("%.3f", epc)) |>
lca_table(align = "llrr", widths = c("12em", "12em", "6em", "6em"),
caption = "Ten largest modification indices for residual covariances. A ranking, not a test.")
#| echo: false
#| eval: !expr k_ready
scale_desc <- "All items are answered on a seven-point ladder where 1 means not at all and 7 means a lot."
fnames <- colnames(lavInspect(fit_w, "std")$lambda)
cat("=========== SYSTEM PROMPT ===========\n")
cat(wrap_text(persona_cfa), "\n\n")
cat("=========== USER PROMPT (", fnames[1], ") ===========\n")
cat(wrap_text(prompt_factor_label(fit_w, dictionary, fnames[1], scale_desc,
cfg$survey_context)), "\n")
#| eval: !expr k_ready
lab_path <- file.path(cfg$cfa_dir, "factor_labels.csv")
if (file.exists(lab_path)) {
factor_labels <- read_csv(lab_path, show_col_types = FALSE)
} else {
factor_labels <- map(fnames, function(fn) {
obj <- parse_json_block(
lca_chat(cfg, persona_cfa)$chat(
prompt_factor_label(fit_w, dictionary, fn, scale_desc, cfg$survey_context),
echo = FALSE))
tibble(factor = fn,
Label = pluck(obj, "label", .default = NA_character_),
Description = pluck(obj, "description", .default = NA_character_),
High_end = pluck(obj, "high_end", .default = NA_character_))
}) |>
list_rbind()
write_csv(factor_labels, lab_path)
}
lca_table(factor_labels, widths = c("5em", "10em", "19em", "7em"),
caption = "Factor names in use. Drafts: verify each against the loading table above before quoting it.")
#| eval: !expr k_ready
# Two score types, for the same reason the class report shows two estimators.
# Regression scores are shrunk toward the grand mean by the factor's reliability,
# which pulls group means together; Bartlett scores are unbiased for the factor
# and therefore for group means, at the cost of more error variance.
FS <- lavPredict(fit_w, method = "Bartlett")
FS_reg <- lavPredict(fit_w, method = "regression")
fnames <- colnames(FS)
scored <- bind_cols(dat, as_tibble(FS))
scored_reg <- bind_cols(dat, as_tibble(FS_reg))
design_s <- build_rep_design(scored, cfg)
rep_des_s <- design_s$rep_des
crit_s <- qt(0.975, degf(rep_des_s))
# A second design on the regression scores. Without it the design-based row and
# the Bartlett row read the same columns and come out identical, and the first
# gap would confound weighting with the choice of score.
rep_des_reg <- build_rep_design(scored_reg, cfg)$rep_des
lam <- unclass(lavInspect(fit_w, "std")$lambda)
anchors <- map_chr(fnames, function(fn) rownames(lam)[which.max(abs(lam[, fn]))])
names(anchors) <- fnames
tibble(Factor = fnames, Label = factor_labels$Label,
Mean = round(colMeans(FS), 3), SD = round(apply(FS, 2, sd), 3),
Indicator = anchors,
Loading = round(map_dbl(fnames, function(fn) lam[anchors[[fn]], fn]), 2)) |>
lca_table(align = "llrrlr", widths = fit_widths(6, first = 1.6), font_size = 8,
caption = glue("Factor positions across the {nrow(scored)} scored respondents."))
#| eval: !expr k_ready
marginals <- map(cfg$aux, function(v) {
m <- svymean(reformulate(v), rep_des_s, na.rm = TRUE)
raw <- scored |> filter(!is.na(.data[[v]])) |>
count(.data[[v]], name = "n") |> set_names(c("level", "n"))
tibble(variable = v, level = str_remove(names(coef(m)), paste0("^", v)),
weighted = as.numeric(coef(m)), se = as.numeric(SE(m))) |>
left_join(mutate(raw, level = as.character(level)), by = "level")
}) |>
list_rbind()
# Three estimators, matching the class report. Unweighted is a plain group mean
# with an iid standard error. Design-based adds the weights and takes its
# variance from the replicates. Bartlett additionally removes the shrinkage that
# regression scores impose on group differences.
dom_one <- function(frame, des, cr, est) {
crossing(variable = cfg$aux, factor = fnames) |>
pmap(function(variable, factor) {
if (is.null(des)) {
d = frame |>
filter(!is.na(.data[[variable]])) |>
group_by(level = as.character(.data[[variable]])) |>
summarise(p = mean(.data[[factor]]),
se = sd(.data[[factor]]) / sqrt(n()), .groups = "drop")
} else {
sb = as.data.frame(svyby(reformulate(factor), reformulate(variable),
des, svymean, na.rm = TRUE))
d = tibble(level = as.character(sb[[1]]), p = sb[[2]], se = sb[[3]])
}
a = anchors[[factor]]
mutate(d, variable = variable, factor = factor,
segment = match(factor, fnames), estimator = est,
expected = mean(as.numeric(dat[[a]]), na.rm = TRUE) +
p * lam[a, factor] * sd(as.numeric(dat[[a]]), na.rm = TRUE),
lo = p - cr * se, hi = p + cr * se)
}) |>
list_rbind()
}
est_levels <- c("Unweighted", "Design-based", "Bartlett")
domain <- bind_rows(
dom_one(scored_reg, NULL, qnorm(0.975), "Unweighted"),
dom_one(scored_reg, rep_des_reg, crit_s, "Design-based"),
dom_one(scored, rep_des_s, crit_s, "Bartlett")) |>
filter(!is.na(level)) |>
mutate(estimator = factor(estimator, levels = est_levels))
wide_gap <- domain |>
select(variable, level, segment, estimator, p, se) |>
pivot_wider(names_from = estimator, values_from = c(p, se))
glue("Weighting moves the factor means by a median of ",
"{round(median(abs(wide_gap$`p_Design-based` - wide_gap$p_Unweighted)), 3)}; ",
"unshrinking them moves a further ",
"{round(median(abs(wide_gap$p_Bartlett - wide_gap$`p_Design-based`)), 3)}. ",
"Design-based intervals are a median of ",
"{round(median(wide_gap$`se_Design-based` / wide_gap$se_Unweighted), 2)} ",
"times the naive ones.")
#| echo: false
#| eval: !expr k_ready
#| results: asis
#| fig-height: 5.2
walk(cfg$aux, function(v) {
d <- filter(domain, variable == v)
lv <- unique(d$level)
cat("\n\n##", v, "\n\n")
d |>
transmute(Factor = factor_labels$Label[segment],
Estimator = as.character(estimator), Level = level,
cell = sprintf("%+.2f (%.3f)", p, se)) |>
pivot_wider(names_from = Level, values_from = cell) |>
arrange(Factor, match(Estimator, est_levels)) |>
lca_table(align = str_c("ll", strrep("r", length(lv))),
widths = fit_widths(2 + length(lv), first = 2.2), font_size = 7,
label = paste0("dom-", str_replace_all(v, "_", "-")),
caption = glue("Mean factor position by level of {v}, three ways.")) |>
cat(sep = "\n")
cat("\n\n")
d |>
filter(estimator == "Bartlett") |>
transmute(Factor = factor_labels$Label[segment], Level = level,
cell = sprintf("%.2f", expected)) |>
pivot_wider(names_from = Level, values_from = cell) |>
lca_table(align = str_c("l", strrep("r", length(lv))),
widths = fit_widths(1 + length(lv), first = 2.2), font_size = 7,
label = paste0("exp-", str_replace_all(v, "_", "-")),
caption = glue("The same positions as an expected answer on each ",
"factor's strongest indicator.")) |>
cat(sep = "\n")
cat("\n\n")
p <- d |>
mutate(Factor = factor(factor_labels$Label[segment],
levels = factor_labels$Label),
Level = factor(level, levels = rev(lv))) |>
ggplot(aes(p, Level, color = estimator, shape = estimator)) +
geom_pointrange(aes(xmin = lo, xmax = hi), size = 0.3, linewidth = 0.35,
position = position_dodge(width = 0.55)) +
facet_wrap(~ Factor, ncol = min(3, length(fnames))) +
scale_color_viridis_d(begin = 0.15, end = 0.75) +
scale_shape_manual(values = c(Unweighted = 15, `Design-based` = 16,
Bartlett = 5)) +
labs(x = "Mean factor position", y = NULL, color = NULL, shape = NULL,
title = v) +
theme_lca()
print(p)
cat("\n\n{{< pagebreak >}}\n\n")
})
#| echo: false
#| eval: !expr k_ready
v1 <- cfg$aux[1]
cat("=========== USER PROMPT (", v1, ") ===========\n")
cat(wrap_text(prompt_domain_read(
domain, marginals, v1,
values_header =
"Mean factor position of each level, with 95 percent intervals:",
labels = factor_labels$Label, context = cfg$survey_context)), "\n")
#| eval: !expr k_ready
domain_reads <- map(cfg$aux, function(v) {
obj <- parse_json_block(
lca_chat(cfg, persona_cfa)$chat(
prompt_domain_read(
domain, marginals, v, labels = factor_labels$Label,
context = cfg$survey_context,
values_header =
"Mean factor position of each level, with 95 percent intervals:"),
echo = FALSE))
tibble(variable = v,
Finding = pluck(obj, "finding", .default = NA_character_),
Caution = pluck(obj, "caution", .default = NA_character_))
}) |>
list_rbind()
lca_table(domain_reads, widths = c("7em", "22em", "16em"),
caption = "Drafted reading of each demographic. Verify against the tables above.")
