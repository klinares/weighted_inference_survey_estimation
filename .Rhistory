library(tidyverse)     # data manipulation and plotting
library(matrixStats)   # numerically stable row-wise log-sum-exp and cumulative sums
library(survey)        # complex-design objects, replicate weights, svyglm
library(poLCA)         # unweighted benchmark latent class model
library(clue)          # solve_LSAP: optimal label alignment across fits
library(furrr)         # future_map_*: parallel model fits (enumeration, screen, poLCA)
# All reusable machinery lives in one annotated source file: the plotting and
# data-prep helpers, the weighted EM engine and label alignment, the LLM
# class-labeling functions. Keep
# survey_lca_source.R in the same folder as
# this document; the render fails if it is not on the path. Sourcing it here, after
# the libraries, means every function is available to the analysis chunks below.
source("survey_lca_source.R")
`%||%` <- rlang::`%||%`  # null-coalescing helper (also defined in the source file)
# Reproducibility is controlled by cfg$seed (set in the configuration block): every
# random step below (the EM random starts and the poLCA starts) seeds
# itself from it, so the classes and their labels are identical across runs.
# poLCA attaches MASS, whose select() and some matrixStats verbs (count) mask
# their tidyverse equivalents. We namespace-qualify dplyr::select(), dplyr::count(),
# and dplyr::distinct() throughout. This is a deliberate, defensive choice.
pd <- list(
# -- where and what -----------------------------------------------------
sav_path = "D:/repos/weighted_and_biased/LCA/data/MEX_2023_LAPOP_AmericasBarometer_v1.0_w.sav",
design   = c(id = "idnum", strata = "strata", psu = "upm", weight = "wt"),
items    = c(                       # english_name = "sav_code", analysis order
justice_system     = "b10a",
electoral_tribunal = "b11",
armed_forces       = "b12",
legislature        = "b13",
public_ministry    = "b15",
police             = "b18",
auditor            = "b19",
political_parties  = "b21",
president          = "b21a",
supreme_court      = "b31",
municipality       = "b32",
media              = "b37",
elections          = "b47a"
),
demo_source = c("q1tc_r", "q2", "edre", "ur", "ocup4a", "pn4", "m1"),
# -- nonresponse ---------------------------------------------------------
na_label_regex = "no sabe|no responde|no contesta|no aplica|^dk$|^nr$|^n/a$",
na_recode_also = c("pn4", "m1", "q2"),   # non-item columns sharing the codes
# -- wording (optional; NULL keeps the labels extracted from the .sav) ----
question_template = "To what extent do you trust the {name}?",
response_labels   = c("Not at all", "2", "3", "4", "5", "6", "A lot"),
# -- demographics: EVERY recode is a function(d) -> vector -----------------
demographics = list(
age_cat = function(d) cut(d$q2, breaks = c(17, 29, 44, 59, Inf),
labels = c("18-29", "30-44", "45-59", "60+"),
right = TRUE),
male = function(d) factor(ifelse(sjlabelled::as_character(d$q1tc_r) ==
"Mujer/femenino", "Female", "Male")),
Edu = function(d) {
e <- sjlabelled::as_character(d$edre)
case_when(e == "Ninguna" ~ "none",
str_detect(e, "^Primaria") ~ "primary",
str_detect(e, "^Secundaria") ~ "secondary",
str_detect(e, "^Universitaria") ~ "higher_ed",
TRUE ~ NA_character_) |>
factor(levels = c("none", "primary", "secondary", "higher_ed"))
},
Urban = function(d) factor(ifelse(sjlabelled::as_character(d$ur) == "Urbano",
"urban", "rural")),
Employment = function(d) {
o <- sjlabelled::as_character(d$ocup4a)
case_when(str_detect(o, "^Trabajando|pero tiene trabajo") ~ "Employed",
str_detect(o, "quehaceres")                     ~ "house_keeper",
str_detect(o, "estudiante")                     ~ "Student",
str_detect(o, "jubilado|pensionado")            ~ "Retired",
str_detect(o, "buscando trabajo|no est\u00e1 buscando") ~ "Unemployed",
TRUE ~ NA_character_) |> factor()
},
satis_demo = function(d) factor(as.numeric(d$pn4), levels = 1:4,
labels = c("Very satisfied", "Satisfied",
"Dissatisfied", "Very dissatisfied")),
prez_rating = function(d) factor(as.numeric(d$m1), levels = 1:5,
labels = c("Very good", "Good",
"Neither good nor bad",
"Bad", "Very bad"))
),
# source column per derived variable, enabling the 'unmatched' audit share
audit_source = c(age_cat = "q2", male = "q1tc_r", Edu = "edre", Urban = "ur",
Employment = "ocup4a", satis_demo = "pn4", prez_rating = "m1")
)
prep       <- prepare_survey_data(pd)
dat        <- prep$dat
dat_before <- prep$dat_before
dictionary <- prep$dictionary
responses  <- prep$responses
items      <- names(pd$items)
